// Fungsi untuk menampilkan data ke dalam tabel HTML
function renderTable(data) {
    const tableBody = document.getElementById('employeeTableBody');
    if (!tableBody) return;
    
    tableBody.innerHTML = '';

    if (data.length === 0) {
        tableBody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-gray-500">Data tidak ditemukan.</td></tr>`;
        return;
    }

    data.forEach((emp) => {
        const row = document.createElement('tr');
        row.className = "hover:bg-gray-50 transition";
        row.innerHTML = `
            <td class="p-3">${emp.no}</td>
            <td class="p-3 font-medium text-gray-900">${emp.nama}</td>
            <td class="p-3">${emp.jabatan}</td>
            <td class="p-3"><span class="px-2 py-1 bg-blue-100 text-blue-800 rounded text-xs font-semibold">${emp.penempatan}</span></td>
            <td class="p-3">${emp.sistemKerja}</td>
            <td class="p-3 font-bold">${emp.grade}</td>
        `;
        tableBody.appendChild(row);
    });
}

// Fitur Pencarian / Filter Karyawan secara real-time
const searchInput = document.getElementById('searchInput');
if (searchInput) {
    searchInput.addEventListener('input', function (e) {
        const keyword = e.target.value.toLowerCase();
        const filteredData = employeeData.filter(emp => 
            emp.nama.toLowerCase().includes(keyword) || 
            emp.jabatan.toLowerCase().includes(keyword) ||
            emp.penempatan.toLowerCase().includes(keyword)
        );
        renderTable(filteredData);
    });
}

// Fungsi Tombol Refresh Data
function refreshData() {
    alert("Menyinkronkan data terbaru dari sistem...");
    renderTable(employeeData);
}

// Jalankan render awal saat halaman pertama kali dimuat
document.addEventListener('DOMContentLoaded', () => {
