// Fungsi untuk memuat data dari file JSON lokal (yang sudah Anda miliki)
async function loadEmployeeData() {
    try {
        const response = await fetch('employee_data.json');
        if (!response.ok) throw new Error('Gagal memuat data');
        
        const data = await response.json();
        renderTable(data);
    } catch (error) {
        console.error("Error:", error);
    }
}

// Fungsi render yang disesuaikan dengan struktur JSON Anda
function renderTable(data) {
    const tableBody = document.getElementById('employeeTableBody');
    if (!tableBody) return;
    
    tableBody.innerHTML = '';

    // Ambil 10 data pertama sebagai contoh tampilan ringkas
    data.slice(0, 10).forEach((emp) => {
        const row = document.createElement('tr');
        row.className = "hover:bg-slate-50 border-b border-slate-100 text-xs";
        row.innerHTML = `
            <td class="p-3 text-slate-500">${emp["No"]}</td>
            <td class="p-3 font-semibold text-slate-800">${emp["Nama Karyawan"]}</td>
            <td class="p-3 text-slate-600">${emp["Job Title"]}</td>
            <td class="p-3"><span class="px-2 py-0.5 bg-blue-50 text-blue-700 rounded font-medium">${emp["Fungsi"]}</span></td>
            <td class="p-3 text-slate-600">Aktif</td>
            <td class="p-3 font-bold text-slate-700">-</td>
        `;
        tableBody.appendChild(row);
    });
}

// Jalankan fungsi saat halaman dimuat
document.addEventListener('DOMContentLoaded', loadEmployeeData);