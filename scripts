// Fungsi untuk merender/menampilkan data ke dalam tabel HTML secara dinamis
function renderTable(data) {
    const tableBody = document.getElementById('employeeTableBody');
    if (!tableBody) return;
    
    tableBody.innerHTML = '';

    if (data.length === 0) {
        tableBody.innerHTML = `<tr><td colspan="6" class="p-4 text-center text-slate-400 text-xs">Data personel tidak ditemukan.</td></tr>`;
        return;
    }

    data.forEach((emp) => {
        const row = document.createElement('tr');
        row.className = "hover:bg-slate-50 transition border-b border-slate-100 text-xs";
        row.innerHTML = `
            <td class="p-3 text-slate-500">${emp.no}</td>
            <td class="p-3 font-semibold text-slate-800">${emp.nama}</td>
            <td class="p-3 text-slate-600">${emp.jabatan}</td>
            <td class="p-3"><span class="px-2 py-0.5 bg-blue-50 text-blue-700 rounded font-medium">${emp.penempatan}</span></td>
            <td class="p-3 text-slate-600">${emp.sistemKerja}</td>
            <td class="p-3 font-bold text-slate-700">${emp.grade}</td>
        `;
        tableBody.appendChild(row);
    });
}

// Fungsi untuk Menarik Data dari Google Sheet / File JSON Eksternal
async function fetchGoogleSheetData() {
    try {
        // Di sini nantinya Anda bisa mengarahkan ke file JSON hasil sinkronisasi Python atau URL API Google Sheet
        const response = await fetch('employee_data.json'); 
        if (response.ok) {
            const data = await response.json();
            if (data && data.length > 0) {
                employeeData = data;
            }
        }
    } catch (error) {
        console.log("Menggunakan data cache/referensi lokal.");
    }
    renderTable(employeeData);
}

// Fitur Pencarian Real-Time pada Tabel
const searchInput = document.getElementById('searchInput');
if (searchInput) {
    searchInput.addEventListener('input', function (e) {
        const keyword = e.target.value.toLowerCase();
        const filteredData = employeeData.filter(emp => 
            emp.nama.toLowerCase().includes(keyword) || 
            emp.jabatan.toLowerCase().includes(keyword) ||
            emp.penempatan.toLowerCase().includes(keyword)
        );
        renderTable(filteredData);
    });
}

// Fungsi Interaktif Tombol Download Excel
